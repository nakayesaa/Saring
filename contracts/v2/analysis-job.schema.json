{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v2/analysis-job.schema.json",
  "title": "SARING Analysis Job v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "run_id", "organization_id", "package_id", "job_kind",
    "status", "stage", "requested_engines", "canonical_snapshot_hash",
    "canonical_snapshot_location", "input_contract_version", "output_contract_version",
    "pipeline_version", "idempotency_key", "attempt", "max_attempts", "lease", "error",
    "created_at", "available_at", "started_at", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": "saring-analysis-job-2.0.0" },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "package_id": { "$ref": "#/$defs/id" },
    "job_kind": { "const": "ANALYSIS" },
    "status": { "enum": ["QUEUED", "CLAIMED", "RUNNING", "COMPLETED", "NEEDS_REVIEW", "ABSTAINED", "FAILED", "CANCELLED"] },
    "stage": { "enum": ["QUEUED", "VALIDATING_SNAPSHOT", "PREPARING_ENGINES", "RUNNING_ENGINES", "FUSING_EVIDENCE", "VALIDATING_RESULTS", "UPLOADING_RESULTS", "COMPLETE"] },
    "requested_engines": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/engine" } },
    "canonical_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "canonical_snapshot_location": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "input_contract_version": { "const": "saring-canonical-analysis-snapshot-1.0.0" },
    "output_contract_version": { "const": "saring-engine-result-2.0.0" },
    "pipeline_version": { "type": "string", "minLength": 1, "maxLength": 200 },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 200 },
    "attempt": { "type": "integer", "minimum": 0, "maximum": 10 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "lease": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lease" }] },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "available_at": { "$ref": "#/$defs/timestamp" },
    "started_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "completed_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["CLAIMED", "RUNNING"] } }, "required": ["status"] },
      "then": { "properties": { "lease": { "$ref": "#/$defs/lease" } } }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": { "properties": { "error": { "$ref": "#/$defs/error" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["COMPLETED", "NEEDS_REVIEW", "ABSTAINED", "FAILED", "CANCELLED"] } }, "required": ["status"] },
      "then": { "properties": { "completed_at": { "$ref": "#/$defs/timestamp" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engine": { "enum": ["PRICE", "DOCUMENT", "GRAPH", "TECHNICAL", "COMPLETENESS", "DATA_QUALITY", "FUSION"] },
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_id", "claimed_at", "heartbeat_at", "expires_at"],
      "properties": {
        "worker_id": { "$ref": "#/$defs/id" },
        "claimed_at": { "$ref": "#/$defs/timestamp" },
        "heartbeat_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
