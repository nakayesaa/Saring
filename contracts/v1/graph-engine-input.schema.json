{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/graph-engine-input.schema.json",
  "title": "SARING Graph Engine Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "package_id", "analysis_cutoff", "canonical_input_hash", "requested_engine_version", "cohort_snapshot_id", "target", "historical_packages"],
  "properties": {
    "schema_version": { "const": "saring-graph-engine-input-1.0.0" },
    "run_id": { "$ref": "#/$defs/id" },
    "package_id": { "$ref": "#/$defs/id" },
    "analysis_cutoff": { "$ref": "#/$defs/timestamp" },
    "canonical_input_hash": { "$ref": "#/$defs/sha256" },
    "requested_engine_version": { "type": "string", "minLength": 1 },
    "cohort_snapshot_id": { "$ref": "#/$defs/id" },
    "target": { "$ref": "#/$defs/target" },
    "historical_packages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/historyPackage" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "vendorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["category_code", "procurement_method", "region_code", "participant_ids"],
      "properties": {
        "category_code": { "type": "string", "minLength": 1 },
        "procurement_method": { "type": "string", "minLength": 1 },
        "region_code": { "type": "string", "minLength": 1 },
        "participant_ids": { "$ref": "#/$defs/vendorIds" }
      }
    },
    "historyPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["historical_package_id", "category_code", "procurement_method", "region_code", "occurred_at", "availability_timestamp", "participant_ids", "opportunity_vendor_ids", "source_system", "source_record_id", "source_hash", "is_synthetic"],
      "properties": {
        "historical_package_id": { "$ref": "#/$defs/id" },
        "category_code": { "type": "string", "minLength": 1 },
        "procurement_method": { "type": "string", "minLength": 1 },
        "region_code": { "type": "string", "minLength": 1 },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "availability_timestamp": { "$ref": "#/$defs/timestamp" },
        "participant_ids": { "$ref": "#/$defs/vendorIds" },
        "opportunity_vendor_ids": { "$ref": "#/$defs/vendorIds" },
        "source_system": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "is_synthetic": { "type": "boolean" }
      }
    }
  }
}
