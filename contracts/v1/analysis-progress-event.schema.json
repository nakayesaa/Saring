{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/analysis-progress-event.schema.json",
  "title": "SARING Analysis Progress Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "job_id",
    "run_id",
    "package_id",
    "engine",
    "event_type",
    "stage",
    "status",
    "completed_units",
    "total_units",
    "unit_label",
    "message",
    "finding_count",
    "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "saring-analysis-progress-event-1.0.0" },
    "event_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "package_id": { "$ref": "#/$defs/id" },
    "engine": {
      "oneOf": [
        { "$ref": "#/$defs/engine" },
        { "type": "null" }
      ]
    },
    "event_type": {
      "enum": [
        "RUN_QUEUED",
        "RUN_STARTED",
        "ENGINE_QUEUED",
        "ENGINE_STARTED",
        "STAGE_STARTED",
        "PROGRESS",
        "ENGINE_COMPLETED",
        "ENGINE_WARNING",
        "ENGINE_ABSTAINED",
        "ENGINE_FAILED",
        "FUSION_STARTED",
        "RUN_COMPLETED",
        "RUN_FAILED"
      ]
    },
    "stage": {
      "enum": [
        "QUEUED",
        "SNAPSHOT_VALIDATION",
        "NORMALIZING_OFFERS",
        "BUILDING_COMPARABLE_COHORT",
        "ESTIMATING_PRICE_RANGE",
        "SCORING_PRICE_DEVIATIONS",
        "EXCLUDING_TEMPLATES",
        "EXTRACTING_PASSAGES",
        "COMPARING_PASSAGES",
        "VALIDATING_DOCUMENT_LOCATORS",
        "RESOLVING_ENTITIES",
        "LOADING_HISTORICAL_EDGES",
        "ENFORCING_ANALYSIS_CUTOFF",
        "EVALUATING_GRAPH_MOTIFS",
        "TECHNICAL_MATCHING",
        "CHECKING_DOCUMENT_COMPLETENESS",
        "CHECKING_DATA_QUALITY",
        "FUSING_EVIDENCE",
        "VALIDATING_RESULTS",
        "COMPLETE"
      ]
    },
    "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "WARNING", "ABSTAINED", "FAILED"] },
    "completed_units": { "type": ["integer", "null"], "minimum": 0 },
    "total_units": { "type": ["integer", "null"], "minimum": 1 },
    "unit_label": { "type": ["string", "null"], "maxLength": 80 },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "finding_count": { "type": ["integer", "null"], "minimum": 0 },
    "occurred_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "PROGRESS" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "completed_units": { "type": "integer", "minimum": 0 },
          "total_units": { "type": "integer", "minimum": 1 },
          "unit_label": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "enum": ["RUN_QUEUED", "RUN_STARTED", "FUSION_STARTED", "RUN_COMPLETED", "RUN_FAILED"] } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "engine": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "enum": ["ENGINE_QUEUED", "ENGINE_STARTED", "ENGINE_COMPLETED", "ENGINE_WARNING", "ENGINE_ABSTAINED", "ENGINE_FAILED"] } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "engine": { "$ref": "#/$defs/engine" } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engine": {
      "enum": ["PRICE", "DOCUMENT", "GRAPH", "TECHNICAL", "COMPLETENESS", "DATA_QUALITY", "FUSION"]
    }
  }
}
