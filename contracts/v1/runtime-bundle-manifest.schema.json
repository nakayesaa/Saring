{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/runtime-bundle-manifest.schema.json",
  "title": "SARING Runtime Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "package_id", "analysis_cutoff_at",
    "bundle_mode", "created_at", "files"
  ],
  "properties": {
    "schema_version": { "const": "saring-runtime-bundle-manifest-1.0.0" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "package_id": { "$ref": "#/$defs/id" },
    "analysis_cutoff_at": { "$ref": "#/$defs/timestamp" },
    "bundle_mode": { "enum": ["LIVE_AUTHORIZED", "RETROSPECTIVE", "SYNTHETIC"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": [
        "file_id", "path", "sha256", "size_bytes", "mime_type", "role",
        "analysis_eligible", "effective_at", "document_id", "vendor_id", "document_type"
      ],
      "properties": {
        "file_id": { "$ref": "#/$defs/id" },
        "path": {
          "type": "string", "minLength": 1, "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
        "mime_type": {
          "enum": [
            "application/json", "text/csv", "application/pdf", "text/plain",
            "text/markdown", "text/x-python",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/octet-stream"
          ]
        },
        "role": {
          "enum": [
            "RUNTIME_EVIDENCE", "CALIBRATION", "EVALUATOR_ONLY",
            "EXPECTED_OUTPUT", "OPERATIONAL"
          ]
        },
        "analysis_eligible": { "type": "boolean" },
        "effective_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "document_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "vendor_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "document_type": {
          "anyOf": [
            {
              "enum": [
                "PACKAGE_METADATA", "AUTHORITY", "PARTICIPANTS", "HPS",
                "ADMINISTRATIVE_BID", "TECHNICAL_BID", "COMMERCIAL_BID",
                "BID_SUMMARY", "DOCUMENT_REGISTRY", "EVALUATION", "NEGOTIATION", "MARKET_COMPARATOR",
                "HISTORICAL_PARTICIPATION", "OTHER"
              ]
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "analysis_eligible": { "const": true } } },
          "then": { "properties": { "role": { "const": "RUNTIME_EVIDENCE" } } }
        }
      ]
    }
  }
}
