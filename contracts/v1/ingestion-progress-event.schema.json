{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/ingestion-progress-event.schema.json",
  "title": "SARING Ingestion Progress Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "sequence", "job_id", "run_id",
    "worker_id", "lease_token", "event_type", "stage", "completed_units",
    "total_units", "unit_label", "message", "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "saring-ingestion-progress-event-1.0.0" },
    "event_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0 },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "lease_token": { "$ref": "#/$defs/lease_token" },
    "event_type": { "enum": ["HEARTBEAT", "STAGE_STARTED", "PROGRESS"] },
    "stage": { "$ref": "#/$defs/stage" },
    "completed_units": { "type": ["integer", "null"], "minimum": 0 },
    "total_units": { "type": ["integer", "null"], "minimum": 1 },
    "unit_label": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "message": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "occurred_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "PROGRESS" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "completed_units": { "type": "integer", "minimum": 0 },
          "total_units": { "type": "integer", "minimum": 1 },
          "unit_label": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "HEARTBEAT" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "completed_units": { "type": "null" },
          "total_units": { "type": "null" },
          "unit_label": { "type": "null" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "lease_token": {
      "type": "string",
      "minLength": 32,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "stage": {
      "enum": [
        "VALIDATING_BUNDLE", "PARSING_STRUCTURED", "PARSING_DOCUMENTS",
        "CANONICALIZING", "UPLOADING_ARTIFACTS"
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "accepted", "lease_expires_at"],
      "properties": {
        "schema_version": { "const": "saring-ingestion-progress-event-1.0.0" },
        "event_id": { "$ref": "#/$defs/id" },
        "accepted": { "const": true },
        "lease_expires_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
