{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/price-model-artifact.schema.json",
  "title": "SARING Price Model Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "engine_version",
    "input_schema_version",
    "output_schema_version",
    "training_dataset_id",
    "training_dataset_hash",
    "feature_spec_hash",
    "model_file_hashes",
    "supported_categories",
    "minimum_comparator_count",
    "calibration_scope",
    "created_at",
    "code_commit"
  ],
  "properties": {
    "schema_version": { "const": "saring-price-model-artifact-1.0.0" },
    "artifact_id": { "$ref": "#/$defs/id" },
    "engine_version": { "type": "string", "minLength": 1 },
    "input_schema_version": { "const": "saring-price-engine-input-1.0.0" },
    "output_schema_version": { "const": "saring-price-engine-detail-1.0.0" },
    "training_dataset_id": { "$ref": "#/$defs/id" },
    "training_dataset_hash": { "$ref": "#/$defs/sha256" },
    "feature_spec_hash": { "$ref": "#/$defs/sha256" },
    "model_file_hashes": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "supported_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "minimum_comparator_count": { "type": "integer", "minimum": 1 },
    "calibration_scope": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "code_commit": { "type": "string", "minLength": 7 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
