{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/analysis-artifact-prepare.schema.json",
  "title": "SARING Analysis Artifact Prepare v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "job_id", "run_id", "worker_id", "lease_token", "artifacts"],
  "properties": {
    "schema_version": { "const": "saring-analysis-artifact-prepare-1.0.0" },
    "request_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "lease_token": { "$ref": "#/$defs/lease_token" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_request" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engine": { "enum": ["PRICE", "DOCUMENT", "GRAPH", "TECHNICAL", "COMPLETENESS", "DATA_QUALITY", "FUSION"] },
    "lease_token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
    "artifact_request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "engine", "sha256", "size_bytes", "schema_version", "media_type"],
      "properties": {
        "kind": { "const": "ENGINE_RESULT" },
        "engine": { "$ref": "#/$defs/engine" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "schema_version": { "const": "saring-engine-result-2.0.0" },
        "media_type": { "const": "application/json" }
      }
    },
    "prepared_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "kind", "engine", "object_key", "sha256", "size_bytes", "schema_version", "media_type", "upload"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "ENGINE_RESULT" },
        "engine": { "$ref": "#/$defs/engine" },
        "object_key": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "schema_version": { "const": "saring-engine-result-2.0.0" },
        "media_type": { "const": "application/json" },
        "upload": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "method", "headers", "expires_at"],
          "properties": {
            "url": { "type": "string", "format": "uri", "maxLength": 8192 },
            "method": { "enum": ["PUT", "POST"] },
            "headers": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z0-9-]+$" }, "additionalProperties": { "type": "string", "maxLength": 4096 } },
            "expires_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "job_id", "run_id", "lease_expires_at", "artifacts"],
      "properties": {
        "schema_version": { "const": "saring-analysis-artifact-prepare-1.0.0" },
        "request_id": { "$ref": "#/$defs/id" },
        "job_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "lease_expires_at": { "$ref": "#/$defs/timestamp" },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "$ref": "#/$defs/prepared_artifact" } }
      }
    }
  }
}
