{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/analysis-result-callback.schema.json",
  "title": "SARING Analysis Result Callback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "callback_id", "job_id", "run_id", "worker_id", "lease_token", "status", "artifacts", "summary", "error", "completed_at"],
  "properties": {
    "schema_version": { "const": "saring-analysis-result-callback-1.0.0" },
    "callback_id": { "$ref": "#/$defs/id" },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "lease_token": { "$ref": "#/$defs/lease_token" },
    "status": { "enum": ["COMPLETED", "NEEDS_REVIEW", "ABSTAINED", "FAILED"] },
    "artifacts": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/artifact_reference" } },
    "summary": { "oneOf": [{ "$ref": "#/$defs/summary" }, { "type": "null" }] },
    "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
    "completed_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["COMPLETED", "NEEDS_REVIEW", "ABSTAINED"] } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifacts": { "type": "array", "minItems": 1, "maxItems": 7 },
          "summary": { "$ref": "#/$defs/summary" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "FAILED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifacts": { "type": "array", "maxItems": 0 },
          "summary": { "type": "null" },
          "error": { "$ref": "#/$defs/error" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engine": { "enum": ["PRICE", "DOCUMENT", "GRAPH", "TECHNICAL", "COMPLETENESS", "DATA_QUALITY", "FUSION"] },
    "lease_token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
    "artifact_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "kind", "engine", "object_key", "sha256", "size_bytes", "schema_version", "media_type"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "kind": { "const": "ENGINE_RESULT" },
        "engine": { "$ref": "#/$defs/engine" },
        "object_key": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "schema_version": { "const": "saring-engine-result-2.0.0" },
        "media_type": { "const": "application/json" }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["engine_count", "scored_count", "low_confidence_count", "abstained_count", "not_applicable_count", "finding_count"],
      "properties": {
        "engine_count": { "type": "integer", "minimum": 1, "maximum": 7 },
        "scored_count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "low_confidence_count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "abstained_count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "not_applicable_count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "finding_count": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" }
      }
    },
    "ack": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "callback_id", "accepted", "status"],
      "properties": {
        "schema_version": { "const": "saring-analysis-result-callback-1.0.0" },
        "callback_id": { "$ref": "#/$defs/id" },
        "accepted": { "const": true },
        "status": { "enum": ["COMPLETED", "NEEDS_REVIEW", "ABSTAINED", "FAILED"] }
      }
    }
  }
}
