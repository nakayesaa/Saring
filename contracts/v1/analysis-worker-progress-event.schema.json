{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/analysis-worker-progress-event.schema.json",
  "title": "SARING Analysis Worker Progress Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "sequence", "job_id", "run_id", "worker_id",
    "lease_token", "event_type", "engine", "stage", "completed_units", "total_units",
    "unit_label", "message", "finding_count", "occurred_at"
  ],
  "properties": {
    "schema_version": { "const": "saring-analysis-worker-progress-event-1.0.0" },
    "event_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1 },
    "job_id": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "worker_id": { "$ref": "#/$defs/id" },
    "lease_token": { "$ref": "#/$defs/lease_token" },
    "event_type": { "enum": ["HEARTBEAT", "STAGE_STARTED", "PROGRESS", "ENGINE_STARTED", "ENGINE_COMPLETED", "ENGINE_ABSTAINED", "ENGINE_FAILED"] },
    "engine": { "oneOf": [{ "$ref": "#/$defs/engine" }, { "type": "null" }] },
    "stage": { "$ref": "#/$defs/stage" },
    "completed_units": { "type": ["integer", "null"], "minimum": 0 },
    "total_units": { "type": ["integer", "null"], "minimum": 1 },
    "unit_label": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "message": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "finding_count": { "type": ["integer", "null"], "minimum": 0 },
    "occurred_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "PROGRESS" } }, "required": ["event_type"] },
      "then": { "properties": {
        "completed_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 1 },
        "unit_label": { "type": "string", "minLength": 1, "maxLength": 80 }
      } }
    },
    {
      "if": { "properties": { "event_type": { "const": "HEARTBEAT" } }, "required": ["event_type"] },
      "then": { "properties": {
        "completed_units": { "type": "null" }, "total_units": { "type": "null" },
        "unit_label": { "type": "null" }, "finding_count": { "type": "null" }
      } }
    },
    {
      "if": { "properties": { "event_type": { "enum": ["ENGINE_STARTED", "ENGINE_COMPLETED", "ENGINE_ABSTAINED", "ENGINE_FAILED"] } }, "required": ["event_type"] },
      "then": { "properties": { "engine": { "$ref": "#/$defs/engine" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_PRICE_ENGINE" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "PRICE" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_DOCUMENT_ENGINE" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "DOCUMENT" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_GRAPH_ENGINE" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "GRAPH" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_TECHNICAL_CHECK" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "TECHNICAL" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_COMPLETENESS_CHECK" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "COMPLETENESS" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "RUNNING_DATA_QUALITY_CHECK" } }, "required": ["stage"] },
      "then": { "properties": { "engine": { "const": "DATA_QUALITY" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engine": { "enum": ["PRICE", "DOCUMENT", "GRAPH", "TECHNICAL", "COMPLETENESS", "DATA_QUALITY", "FUSION"] },
    "lease_token": { "type": "string", "minLength": 32, "maxLength": 512, "pattern": "^[A-Za-z0-9_-]+$" },
    "stage": { "enum": [
      "VALIDATING_SNAPSHOT", "PREPARING_ENGINES", "RUNNING_PRICE_ENGINE",
      "RUNNING_DOCUMENT_ENGINE", "RUNNING_GRAPH_ENGINE", "RUNNING_TECHNICAL_CHECK",
      "RUNNING_COMPLETENESS_CHECK", "RUNNING_DATA_QUALITY_CHECK", "FUSING_EVIDENCE",
      "VALIDATING_RESULTS", "UPLOADING_RESULTS"
    ] },
    "ack": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "accepted", "lease_expires_at"],
      "properties": {
        "schema_version": { "const": "saring-analysis-worker-progress-event-1.0.0" },
        "event_id": { "$ref": "#/$defs/id" },
        "accepted": { "const": true },
        "lease_expires_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
