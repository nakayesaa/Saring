{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saring.local/contracts/v1/price-observation.schema.json",
  "title": "SARING Price Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_kind",
    "availability_timestamp",
    "observed_at",
    "product",
    "price",
    "commercial_basis",
    "market_context",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "saring-price-observation-1.0.0" },
    "observation_id": { "$ref": "#/$defs/id" },
    "source_kind": {
      "enum": ["PUBLIC_CATALOG", "PROCUREMENT_HISTORY", "AUTHORIZED_INTERNAL", "SYNTHETIC"]
    },
    "availability_timestamp": { "$ref": "#/$defs/timestamp" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "product": { "$ref": "#/$defs/product" },
    "price": { "$ref": "#/$defs/price" },
    "commercial_basis": { "$ref": "#/$defs/commercialBasis" },
    "market_context": { "$ref": "#/$defs/marketContext" },
    "quality": { "$ref": "#/$defs/quality" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableString": { "type": ["string", "null"] },
    "triState": { "enum": ["INCLUDED", "EXCLUDED", "UNKNOWN"] },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category_code",
        "brand",
        "model",
        "part_number",
        "condition",
        "specifications",
        "configuration_fingerprint",
        "resolution_level"
      ],
      "properties": {
        "category_code": { "type": "string", "minLength": 1 },
        "brand": { "$ref": "#/$defs/nullableString" },
        "model": { "$ref": "#/$defs/nullableString" },
        "part_number": { "$ref": "#/$defs/nullableString" },
        "condition": { "enum": ["NEW", "USED", "REFURBISHED", "UNKNOWN"] },
        "specifications": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "configuration_fingerprint": { "$ref": "#/$defs/nullableString" },
        "resolution_level": {
          "enum": ["EXACT_SKU", "STRICT_CONFIGURATION", "RELAXED_CONFIGURATION", "UNRESOLVED"]
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "unit",
        "quantity_basis",
        "normalized_unit_price",
        "normalization_method"
      ],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "unit": { "type": "string", "minLength": 1 },
        "quantity_basis": { "type": "number", "exclusiveMinimum": 0 },
        "normalized_unit_price": { "type": "number", "exclusiveMinimum": 0 },
        "normalization_method": { "type": "string", "minLength": 1 }
      }
    },
    "commercialBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tax",
        "shipping",
        "installation",
        "configuration_service",
        "bundled_software_service",
        "warranty_months",
        "delivery_days",
        "payment_terms_code"
      ],
      "properties": {
        "tax": { "$ref": "#/$defs/triState" },
        "shipping": { "$ref": "#/$defs/triState" },
        "installation": { "$ref": "#/$defs/triState" },
        "configuration_service": { "$ref": "#/$defs/triState" },
        "bundled_software_service": { "$ref": "#/$defs/triState" },
        "warranty_months": { "type": ["integer", "null"], "minimum": 0 },
        "delivery_days": { "type": ["integer", "null"], "minimum": 0 },
        "payment_terms_code": { "$ref": "#/$defs/nullableString" }
      }
    },
    "marketContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "region_code",
        "seller_id",
        "seller_type",
        "channel",
        "procurement_or_listing_date",
        "source_record_id"
      ],
      "properties": {
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "region_code": { "$ref": "#/$defs/nullableString" },
        "seller_id": { "$ref": "#/$defs/nullableString" },
        "seller_type": { "$ref": "#/$defs/nullableString" },
        "channel": { "type": "string", "minLength": 1 },
        "procurement_or_listing_date": { "$ref": "#/$defs/timestamp" },
        "source_record_id": { "type": "string", "minLength": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_status",
        "is_synthetic",
        "duplicate_group_id",
        "field_completeness",
        "product_resolution_confidence",
        "price_basis_confidence",
        "comparator_decision",
        "exclusion_reason_code"
      ],
      "properties": {
        "record_status": { "enum": ["VALID", "QUARANTINED", "REJECTED"] },
        "is_synthetic": { "type": "boolean" },
        "duplicate_group_id": { "$ref": "#/$defs/nullableString" },
        "field_completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "product_resolution_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "price_basis_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "comparator_decision": { "enum": ["ELIGIBLE", "EXCLUDED", "PENDING"] },
        "exclusion_reason_code": { "$ref": "#/$defs/nullableString" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uri",
        "source_hash",
        "ingestion_run_id",
        "locator_id",
        "parser_version",
        "normalizer_version"
      ],
      "properties": {
        "source_uri": { "type": "string", "minLength": 1 },
        "source_hash": { "$ref": "#/$defs/sha256" },
        "ingestion_run_id": { "$ref": "#/$defs/id" },
        "locator_id": { "$ref": "#/$defs/id" },
        "parser_version": { "type": "string", "minLength": 1 },
        "normalizer_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
