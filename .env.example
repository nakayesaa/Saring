# Browser-safe Supabase configuration. Never place service-role keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Elevated server-only key for private Storage operations. Never expose it to
# browser code or send it to the analysis engine.
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# Runtime connection: use Supavisor transaction mode (port 6543). Every
# tenant transaction immediately assumes the NOLOGIN saring_app role.
DATABASE_URL="postgresql://postgres.project-ref:password@region.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# Migration connection: use a privileged direct/session connection only in CI/local tooling.
DIRECT_URL="postgresql://postgres.project-ref:password@region.pooler.supabase.com:5432/postgres?sslmode=require"

# Explicit local-only escape hatch. The code rejects this when NODE_ENV=production.
DEMO_BYPASS_AUTH="false"

# Used to HMAC network identifiers before audit persistence. Generate >= 32 random bytes.
AUDIT_HASH_SECRET="replace-with-a-long-random-secret"

# Analysis transport. Keep fixture until the external Python service is ready.
ANALYSIS_ENGINE_DRIVER="fixture"
APP_BASE_URL="http://localhost:3000"
ANALYSIS_ENGINE_URL="https://analysis-engine.internal.example/v1/jobs"
ANALYSIS_ENGINE_TOKEN="replace-with-at-least-32-random-characters"
ANALYSIS_CALLBACK_TOKEN="replace-with-a-different-32-character-secret"

# Development accepts synthetic fixtures only. Configure the HTTP scanner
# before accepting authorized or retrospective evidence.
MALWARE_SCANNER_DRIVER="synthetic-only"
MALWARE_SCANNER_URL="https://scanner.internal.example/v1/scan"
MALWARE_SCANNER_TOKEN="replace-with-at-least-32-random-characters"
